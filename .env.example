# setup.ps1 creates .env with a random local password. Do not commit .env.
COMPOSE_PROJECT_NAME=cascadeshield-demo
FRONTEND_PORT=5173
BACKEND_PORT=8080
POSTGRES_PORT=55433
ML_PORT=8090
POSTGRES_DB=cascadeshield_demo
POSTGRES_USER=cascadeshield_demo
POSTGRES_PASSWORD=
# Optional official-Maven relay for a host with restricted Docker HTTPS access.
MAVEN_MIRROR_URL=
# Optional separately installed ML service. Default is unavailable inside backend.
SIMULATOR_ML_URL=http://127.0.0.1:8090
